SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///civicdesk.sqlite
MODEL_PATH=models/grievance_pipeline.joblib
COOKIE_SECURE=0
PORT=5000

# Admin bootstrap (use only when running flask create-admin)
ADMIN_NAME=Project Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-12-or-more-characters

# Optional SMTP email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
DEPARTMENT_EMAIL_ACADEMICS=
DEPARTMENT_EMAIL_CANTEEN=
DEPARTMENT_EMAIL_HOSTEL=
DEPARTMENT_EMAIL_LIBRARY=
DEPARTMENT_EMAIL_TRANSPORT=
DEPARTMENT_EMAIL_OTHERS=

# Account security
REQUIRE_EMAIL_VERIFICATION=0
